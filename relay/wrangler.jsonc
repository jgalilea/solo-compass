// The sync relay (see README.md here). Its URL goes into the app's .env
// (VITE_SYNC_RELAY_URL) and, from there, into its Content Security Policy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solo-compass-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // No request logs: the app's privacy note says the relay keeps no IP
  // addresses or browser details, and Workers Logs would (Cloudflare's
  // own request counts in the dashboard are enough to watch it).
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "BOXES", "class_name": "SyncBox" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncBox"] }],
  "vars": {
    // Only the app may call it (browsers enforce it; it's no lock).
    "ALLOWED_ORIGINS": "https://jgalilea.github.io",
    // Raise it (seconds) to slow every device down without a new app version.
    "MIN_WAIT": "0",
  },
  // Optional, against someone making boxes by the thousand: new boxes
  // per IP and minute. Uncomment if the account allows it.
  // "ratelimits": [{ "name": "NEW_BOXES", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
