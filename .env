# The device sync's relay (relay/, a Cloudflare Worker): its address, with
# no trailing slash, e.g. https://solo-compass-sync.<subdomain>.workers.dev
# Empty: this build has no device sync (Settings doesn't offer it). It's
# public on purpose (it ends up in the app's code and its Content Security
# Policy); for a local relay, put VITE_SYNC_RELAY_URL=http://localhost:8787
# in .env.local (not committed).
VITE_SYNC_RELAY_URL=https://solo-compass-sync.jgalilea.workers.dev
